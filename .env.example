# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string. On Vercel, use Neon's pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A long random string. The scheduler sends it to /api/jobs/release-holds.
CRON_SECRET=replace-with-a-long-random-string
